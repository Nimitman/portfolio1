---
// 05 · People. Noise → order: a scattered crowd forms a structure.
// Drag a figure to reveal who it is. The face appears for the first time here.
const roles = [
  'PM',
  'Sales head',
  'Engineering lead',
  'Broker',
  'Designer',
  'Designer',
  'Broker',
  'Engineer',
  'Designer',
  'Leadership',
  'Designer',
  'Seller',
];
---

<section class="chapter" id="people" data-chapter="people" data-cursor="grab">
  <div class="stage">
    <div class="stage-inner">
      <div class="copy">
        <p class="eyebrow">05 · People · 30 km</p>
        <h2>We build the people and systems that build the product.</h2>
        <p>Every decision on this page had a PM, a sales head, an engineering lead, brokers and designers behind it. Drag them apart to see who.</p>
        <ul class="pp-evidence">
          <li><b>Competency framework.</b> <span class="tbd" data-q="Q15">What it measures, who uses it.</span></li>
          <li><b>UX/UI Slack channel.</b> An org-wide feedback system, not a design-team chat.</li>
          <li><b>Hiring and growing designers.</b> <span class="tbd" data-q="Q10">One story of a designer we grew.</span></li>
        </ul>
      </div>
      <div class="scene pp-scene">
        <div class="pp-face" aria-hidden="true">
          <div class="pp-face-inner">
            <span class="pp-eye"><i></i></span>
            <span class="pp-eye"><i></i></span>
          </div>
          <span class="pp-face-tag mono">placeholder · Q18</span>
        </div>
        <div class="pp-crowd">
          {
            roles.map((r, i) => (
              <div class="pp-fig" data-role={r} data-i={i} tabindex="0" role="button" aria-label={r}>
                <span class="pp-head" />
                <span class="pp-body" />
                <span class="pp-label mono">{r}</span>
              </div>
            ))
          }
        </div>
        <div class="note" style="top:2%;right:2%"><b>Roles</b>Drag a figure to see who sits behind the work</div>
      </div>
    </div>
  </div>
</section>

<style>
  .pp-evidence {
    margin: 16px 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 10px;
    max-width: 44ch;
    color: var(--ink-2);
    font-size: 15px;
  }
  @media (max-width: 820px) {
    .pp-evidence {
      font-size: 13px;
      gap: 6px;
      margin-top: 8px;
    }
  }
  .pp-evidence b {
    color: var(--ink);
    font-weight: 600;
  }
  .pp-crowd {
    position: absolute;
    inset: 0;
  }
  .pp-fig {
    position: absolute;
    left: 0;
    top: 0;
    width: 44px;
    height: 76px;
    display: flex;
    flex-direction: column;
    align-items: center;
    touch-action: none;
    user-select: none;
    will-change: transform;
  }
  .pp-head {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--ink);
  }
  .pp-body {
    margin-top: 4px;
    width: 36px;
    height: 40px;
    border-radius: 18px 18px 6px 6px;
    background: var(--ink);
    opacity: 0.85;
  }
  .pp-fig[data-role='Designer'] .pp-head,
  .pp-fig[data-role='Designer'] .pp-body {
    background: var(--signal);
  }
  .pp-label {
    position: absolute;
    top: 80px;
    white-space: nowrap;
    padding: 2px 6px;
    border-radius: 4px;
    background: var(--ink);
    color: var(--paper);
    font-size: 10px;
    opacity: 0;
    transform: translateY(-4px);
    transition: opacity 0.2s, transform 0.2s;
  }
  :global(html[data-lens='structure']) .pp-label,
  .pp-fig.revealed .pp-label,
  .pp-fig:focus-visible .pp-label {
    opacity: 1;
    transform: none;
  }
  .pp-fig.dragging {
    z-index: 3;
  }
  .pp-face {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 120px;
    height: 120px;
    margin: -60px 0 0 -60px;
    opacity: 0;
  }
  .pp-face-inner {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: var(--paper-2);
    border: 1px solid var(--rule);
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 22px;
  }
  .pp-eye {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--paper);
    border: 1px solid var(--ink);
    display: grid;
    place-items: center;
  }
  .pp-eye i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--ink);
    will-change: transform;
  }
  .pp-face-tag {
    position: absolute;
    top: 128px;
    left: 50%;
    transform: translateX(-50%);
    white-space: nowrap;
    color: var(--ink-3);
    font-size: 10px;
  }
</style>
