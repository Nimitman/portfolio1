---
// Signature interaction. One element, six tools. State is set by the chapter in view.
// Each glyph is self-contained so a Rive file can later replace any single state.
---

<div class="cursor" id="cursor" data-state="caret" aria-hidden="true">
  <div class="cursor-glyph" data-glyph="caret">
    <svg viewBox="0 0 24 32" width="24" height="32"><rect x="11" y="3" width="2" height="26" fill="currentColor"></rect><rect x="7" y="2" width="10" height="2" fill="currentColor"></rect><rect x="7" y="28" width="10" height="2" fill="currentColor"></rect></svg>
  </div>
  <div class="cursor-glyph" data-glyph="inspector">
    <svg viewBox="0 0 40 40" width="40" height="40"><circle cx="20" cy="20" r="9" fill="none" stroke="currentColor" stroke-width="1.25"></circle><path d="M20 2v10M20 28v10M2 20h10M28 20h10" stroke="currentColor" stroke-width="1.25"></path><rect x="19" y="19" width="2" height="2" fill="var(--signal)"></rect></svg>
    <div class="cursor-tip mono"></div>
  </div>
  <div class="cursor-glyph" data-glyph="peel">
    <svg viewBox="0 0 40 40" width="40" height="40"><path d="M14 30c-4-3-7-8-7-11 0-1.6 1.8-2.2 3-1l3 3V8.5a2 2 0 0 1 4 0V18V6.5a2 2 0 0 1 4 0V18V8a2 2 0 0 1 4 0v10.5V11a2 2 0 0 1 4 0v12c0 5-3 9-8 9h-3c-1.5 0-3-.7-4-2z" fill="var(--paper)" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"></path><path d="M28 4l8 0 0 8z" fill="var(--signal)"></path></svg>
  </div>
  <div class="cursor-glyph" data-glyph="magnet">
    <svg viewBox="0 0 40 40" width="40" height="40"><path d="M10 8v12a10 10 0 0 0 20 0V8h-6v12a4 4 0 0 1-8 0V8z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path><path d="M10 8h6v5h-6zM24 8h6v5h-6z" fill="var(--signal)"></path></svg>
  </div>
  <div class="cursor-glyph" data-glyph="grab">
    <svg viewBox="0 0 40 40" width="40" height="40"><path d="M12 18v-4a2 2 0 0 1 4 0v3-6a2 2 0 0 1 4 0v6-7a2 2 0 0 1 4 0v7-5a2 2 0 0 1 4 0v10c0 6-3.5 10-9 10h-1c-4 0-6.5-2-8.5-5L7 22c-.8-1.4.8-3 2.2-2.2L12 22z" fill="var(--paper)" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"></path></svg>
  </div>
  <div class="cursor-glyph" data-glyph="light">
    <div class="cursor-light"></div>
  </div>
</div>
<div class="ripple-layer" id="ripples" aria-hidden="true"></div>

<style>
  .cursor {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 90;
    pointer-events: none;
    color: var(--ink);
    opacity: 0;
    transition: opacity 0.3s;
  }
  :global(html.has-cursor) .cursor {
    opacity: 1;
  }
  :global(html.has-cursor),
  :global(html.has-cursor *) {
    cursor: none !important;
  }
  :global(html.touch) .cursor,
  :global(html.rm) .cursor {
    display: none;
  }
  .cursor-glyph {
    position: absolute;
    left: 0;
    top: 0;
    transform: translate(-50%, -50%) scale(0.4);
    opacity: 0;
    transition: opacity 0.25s, transform 0.45s var(--ease-out);
  }
  .cursor[data-state='caret'] [data-glyph='caret'],
  .cursor[data-state='inspector'] [data-glyph='inspector'],
  .cursor[data-state='peel'] [data-glyph='peel'],
  .cursor[data-state='magnet'] [data-glyph='magnet'],
  .cursor[data-state='grab'] [data-glyph='grab'],
  .cursor[data-state='light'] [data-glyph='light'] {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }
  .cursor[data-state='caret'] [data-glyph='caret'] svg {
    animation: caret-blink 1.06s steps(1) infinite;
  }
  .cursor.is-down .cursor-glyph {
    transform: translate(-50%, -50%) scale(0.86);
  }
  .cursor.is-link [data-glyph] svg {
    color: var(--signal);
  }
  .cursor-tip {
    position: absolute;
    left: 28px;
    top: 26px;
    white-space: pre;
    padding: 6px 8px;
    background: var(--ink);
    color: var(--paper);
    border-radius: 4px;
    font-size: 11px;
    line-height: 1.5;
    opacity: 0;
    transition: opacity 0.15s;
  }
  .cursor-tip.on {
    opacity: 1;
  }
  .cursor-light {
    width: 320px;
    height: 320px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 214, 160, 0.22) 0%, rgba(255, 180, 120, 0.06) 40%, transparent 70%);
    mix-blend-mode: screen;
  }
  .ripple-layer {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 90;
  }
  .ripple-layer :global(span) {
    position: absolute;
    width: 48px;
    height: 48px;
    margin: -24px 0 0 -24px;
    border-radius: 50%;
    border: 1.5px solid var(--signal);
    animation: ripple 0.6s var(--ease-out) forwards;
  }
  @keyframes ripple {
    from {
      transform: scale(0.2);
      opacity: 1;
    }
    to {
      transform: scale(1.4);
      opacity: 0;
    }
  }
  @keyframes caret-blink {
    50% {
      opacity: 0.2;
    }
  }
</style>
