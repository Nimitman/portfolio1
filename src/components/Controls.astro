---
import { url } from '../data/url';
// Top-right: lens switch (Surface / Structure), sound toggle, 30-second version.
---

<div class="controls">
  <a class="ctl-brief mono" href={url('/brief')}>30-second version</a>
  <div class="lens" role="group" aria-label="Lens">
    <button type="button" data-lens-set="surface" aria-pressed="true">Surface</button>
    <button type="button" data-lens-set="structure" aria-pressed="false">Structure</button>
    <span class="lens-thumb" aria-hidden="true"></span>
  </div>
  <p class="lens-hint mono" role="status" hidden>Structure shows how each frame is built. Switch back to Surface anytime.</p>
  <button class="sound" type="button" aria-label="Sound off">
    <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
      <g class="bars" fill="currentColor">
        <rect x="3" y="8" width="2" height="4" rx="1"></rect>
        <rect x="7" y="5" width="2" height="10" rx="1"></rect>
        <rect x="11" y="7" width="2" height="6" rx="1"></rect>
        <rect x="15" y="9" width="2" height="2" rx="1"></rect>
      </g>
    </svg>
    <span class="sound-label mono">Sound off</span>
  </button>
</div>

<style>
  .controls {
    position: fixed;
    top: 16px;
    right: var(--gutter);
    z-index: 50;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .controls > * {
    border: 1px solid var(--rule);
    background: var(--glass);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
  .ctl-brief {
    padding: 11px 14px;
    border-radius: 999px;
    text-decoration: none;
    color: var(--ink-2);
  }
  .ctl-brief:hover {
    color: var(--ink);
  }
  .lens {
    position: relative;
    display: flex;
    padding: 3px;
    border-radius: 999px;
  }
  .lens button {
    position: relative;
    z-index: 1;
    border: 0;
    background: none;
    padding: 8px 12px;
    font-size: 13px;
    color: var(--ink-3);
    cursor: pointer;
    transition: color 0.25s;
  }
  .lens button[aria-pressed='true'] {
    color: var(--paper);
  }
  .lens-thumb {
    position: absolute;
    top: 3px;
    bottom: 3px;
    left: 3px;
    border-radius: 999px;
    background: var(--ink);
    transition: transform 0.4s var(--ease-out), width 0.4s var(--ease-out), background 0.3s;
  }
  :global(html[data-lens='structure']) .lens-thumb {
    background: var(--structure);
  }
  .sound {
    height: 42px;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0 14px 0 12px;
    border-radius: 999px;
    cursor: pointer;
    color: var(--ink-3);
  }
  .sound .bars rect {
    transform-origin: center;
    transform-box: fill-box;
    transform: scaleY(0.3);
    transition: transform 0.3s;
  }
  .sound.on {
    color: var(--signal);
  }
  .sound.on .bars rect {
    animation: eq 1.2s ease-in-out infinite alternate;
  }
  .sound.on .bars rect:nth-child(2) {
    animation-delay: -0.3s;
  }
  .sound.on .bars rect:nth-child(3) {
    animation-delay: -0.6s;
  }
  .sound.on .bars rect:nth-child(4) {
    animation-delay: -0.9s;
  }
  @keyframes eq {
    from {
      transform: scaleY(0.4);
    }
    to {
      transform: scaleY(1.4);
    }
  }
  .sound-label {
    font-size: 12px;
  }
  .lens-hint {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    max-width: 260px;
    margin: 0;
    padding: 8px 12px;
    border-radius: 8px;
    font-size: 11px;
    line-height: 1.45;
    color: var(--ink-2);
  }
  @media (max-width: 820px) {
    .ctl-brief,
    .sound-label {
      display: none;
    }
    .sound {
      width: 42px;
      padding: 0;
      justify-content: center;
    }
    .lens button {
      padding: 8px 9px;
      font-size: 12px;
    }
  }
</style>
